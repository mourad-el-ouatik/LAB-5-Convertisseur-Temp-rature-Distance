<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Bar d'onglets -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E2E"
        android:elevation="6dp"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorColor="#7C83FD"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#7C83FD"
        app:tabTextColor="#9A9AB0"
        app:tabTextAppearance="@android:style/TextAppearance.Medium"
        app:tabRippleColor="#2C2C3E"
        app:tabGravity="fill"/>

    <!-- Séparateur subtil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C3E"/>

    <!-- Conteneur pour afficher les fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>