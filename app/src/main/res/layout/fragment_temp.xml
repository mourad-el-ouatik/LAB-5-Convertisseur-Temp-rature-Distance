<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Titre -->
    <TextView
        android:text="Conversion Celsius ↔ Fahrenheit"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#1E1E2E"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Card contenant le formulaire -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Label direction -->
            <TextView
                android:text="Direction de conversion"
                android:textSize="12sp"
                android:textColor="#9A9AB0"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- RadioGroup stylisé -->
            <RadioGroup
                android:id="@+id/rgTemp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCtoF"
                    android:text="°C → °F"
                    android:checked="true"
                    android:textColor="#1E1E2E"
                    android:buttonTint="#7C83FD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/rbFtoC"
                    android:text="°F → °C"
                    android:textColor="#1E1E2E"
                    android:buttonTint="#7C83FD"
                    android:layout_marginStart="24dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RadioGroup>

            <!-- Champ de saisie -->
            <TextView
                android:text="Valeur à convertir"
                android:textSize="12sp"
                android:textColor="#9A9AB0"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etTempInput"
                android:hint="ex: 37"
                android:inputType="numberDecimal"
                android:textColor="#1E1E2E"
                android:textColorHint="#C4C4D4"
                android:background="@drawable/bg_input_rounded"
                android:padding="14dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Bouton Calculer -->
            <Button
                android:id="@+id/btnConvertTemp"
                android:text="Calculer"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#7C83FD"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Carte Résultat -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1E1E2E">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="RÉSULTAT"
                android:textSize="11sp"
                android:textColor="#9A9AB0"
                android:letterSpacing="0.15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvTempResult"
                android:text="—"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#7C83FD"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>